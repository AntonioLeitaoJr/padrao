# ====================================================================
# SISTEMA DE ELEIÇÃO DOS PADRÕES COMARA - ARQUIVO DE CONFIGURAÇÃO (.env)
# ====================================================================
# Copie este arquivo para .env e preencha conforme seu ambiente:
# cp .env.example .env

# Ambiente: 'production' ou 'development'
APP_ENV=production

# Chave secreta de aplicação (gere uma sequência segura aleatória de 32+ caracteres)
APP_KEY=COMARA_PADRAO_SECURE_KEY_2026_!@#$99

# --------------------------------------------------------------------
# Banco de Dados MySQL (aaPanel / Debian 13 ou Docker)
# --------------------------------------------------------------------
# No aaPanel local: 127.0.0.1
# No Docker Compose: db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=comara_votacao
DB_USER=root
DB_PASS=

# --------------------------------------------------------------------
# Integração SIGPES CCARJ (Fotografias e Dados do Efetivo FAB)
# --------------------------------------------------------------------
# Produção INTRAER: http://api.servicos.ccarj.intraer/sigpesApi
# Homologação:      http://api.servicos.homolog.ccarj.intraer/sigpesApi
SIGPES_API_BASE=http://api.servicos.homolog.ccarj.intraer/sigpesApi

# --------------------------------------------------------------------
# Integração Active Directory / LDAP INTRAER
# --------------------------------------------------------------------
LDAP_HOST=ldap.comara.intraer
LDAP_PORT=389
LDAP_DOMAIN=intraer
LDAP_BASE_DN=DC=intraer,DC=fab,DC=mil,DC=br
LDAP_USE_SSL=false
# Mantém fallback para autenticação local e contingência
LDAP_LOCAL_FALLBACK=true

# Zeramento extraordinário da base (desativado por padrão; habilitar somente com STI em manutenção)
ALLOW_DATABASE_RESET=false
